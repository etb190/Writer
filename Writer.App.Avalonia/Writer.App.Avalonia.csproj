<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup><WriterBrand Condition="'$(WriterBrand)' == ''">Writer</WriterBrand></PropertyGroup>
  <Import Project="../shared/Writer.Shared.Shell/BrandAssets.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Writer</AssemblyName>
    <ApplicationTitle>Writer</ApplicationTitle>
    <RootNamespace>Writer.App.Avalonia</RootNamespace>
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <Import Project="../Writer.Ribbon.Definitions/Writer.Ribbon.Assets.props" />

  <PropertyGroup Condition="'$(WriterValidationHost)' == 'true'">
    <OutputPath>bin/Validation/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/Validation/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WriterHostTestSupport)' == 'true'">
    <OutputPath>bin/TestSupport/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/TestSupport/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WriterDialogHarnessSupport)' == 'true'">
    <OutputPath>bin/DialogHarness/$(Configuration)/</OutputPath>
    <IntermediateOutputPath>obj/DialogHarness/$(Configuration)/$(TargetFramework)/</IntermediateOutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(WriterHostTestSupport)' == 'true'">
    <Compile Include="../TestSupport/HostAccess.Avalonia/MainWindow.TestAccess.cs"
             Link="MainWindow.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/DocumentView.TestAccess.cs"
             Link="Editing/DocumentView.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/AutosaveAdapter.TestAccess.cs"
             Link="AutosaveAdapter.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/DialogsAndPanes.TestAccess.cs"
             Link="DialogsAndPanes.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/Backstage.TestAccess.cs"
             Link="Backstage/Backstage.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/CupsPrintDialog.TestAccess.cs"
             Link="Printing/CupsPrintDialog.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/EditingControls.TestAccess.cs"
             Link="Editing/EditingControls.TestAccess.cs" />
  </ItemGroup>

  <ItemDefinitionGroup Condition="'$(WriterHostTestSupport)' == 'true'">
    <ProjectReference>
      <GlobalPropertiesToRemove>WriterHostTestSupport</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(WriterDialogHarnessSupport)' == 'true'">
    <ProjectReference>
      <GlobalPropertiesToRemove>WriterDialogHarnessSupport</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup Condition="'$(WriterValidationHost)' == 'true'">
    <Compile Include="../TestSupport/Validation.Avalonia/Program.ValidationHost.cs"
             Link="Program.ValidationHost.cs" />
    <Compile Include="../TestSupport/Validation.Avalonia/MainWindow.ValidationAccessAdapter.cs"
             Link="MainWindow.ValidationAccessAdapter.cs" />
    <Compile Include="../TestSupport/Validation.Avalonia/AvaloniaSpeechEngine.ValidationAccess.cs"
             Link="AvaloniaSpeechEngine.ValidationAccess.cs" />
  </ItemGroup>

  <ItemDefinitionGroup Condition="'$(WriterValidationHost)' == 'true'">
    <ProjectReference>
      <GlobalPropertiesToRemove>WriterValidationHost</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../shared/Writer.Shared.Drawing/Writer.Shared.Drawing.csproj" />
    <ProjectReference Include="../Writer.Core.Model/Writer.Core.Model.csproj" />
    <ProjectReference Include="../Writer.Core.IO/Writer.Core.IO.csproj" />
    <ProjectReference Include="../Writer.App.Presentation/Writer.App.Presentation.csproj" />
    <ProjectReference Include="../Writer.Ribbon.Definitions/Writer.Ribbon.Definitions.csproj" />
    <ProjectReference Include="../Writer.App.Localization/Writer.App.Localization.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.AppServices/Writer.Shared.AppServices.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.AppServices.Windows/Writer.Shared.AppServices.Windows.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Ribbon/Writer.Shared.Ribbon.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Ribbon.Avalonia/Writer.Shared.Ribbon.Avalonia.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Shell.Avalonia/Writer.Shared.Shell.Avalonia.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Shell/Writer.Shared.Shell.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Theme/Writer.Shared.Theme.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Theme.Avalonia/Writer.Shared.Theme.Avalonia.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Pdf/Writer.Shared.Pdf.csproj" />
    <ProjectReference Include="../shared/Writer.Shared.Pdf.Skia/Writer.Shared.Pdf.Skia.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(WriterHostTestSupport)' == 'true'">
    <InternalsVisibleTo Include="Writer.App.Avalonia.Tests" />
    <!-- Validation smoke tests execute against this host-test variant in the shared test process. -->
    <InternalsVisibleTo Include="Writer.Validation.Avalonia" />
  </ItemGroup>

  <ItemGroup Condition="'$(WriterDialogHarnessSupport)' == 'true'">
    <Compile Include="../TestSupport/HostAccess.Avalonia/DialogsAndPanes.TestAccess.cs"
             Link="DialogsAndPanes.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/ScreenClipOverlay.DialogHarnessAccess.cs"
             Link="Editing/ScreenClipOverlay.DialogHarnessAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/Backstage.TestAccess.cs"
             Link="Backstage/Backstage.TestAccess.cs" />
    <Compile Include="../TestSupport/HostAccess.Avalonia/CupsPrintDialog.TestAccess.cs"
             Link="Printing/CupsPrintDialog.TestAccess.cs" />
    <InternalsVisibleTo Include="Writer.DialogVisualHarness.Avalonia" />
  </ItemGroup>

  <ItemGroup Condition="'$(WriterValidationHost)' == 'true'">
    <InternalsVisibleTo Include="Writer.Validation.Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Writer.App.Localization.LocalizedUiText" Alias="UiText" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Command icon artwork is embedded into the app assembly so the single-file portable
      build shows the full Office-style glyph set even when no loose Resources folder
      ships next to the executable. AvaloniaRibbonIcons reads these manifest resources as
      a fallback after the on-disk Resources/CommandIconsSvg directory.
    -->
    <EmbeddedResource Include="../Writer.Ribbon.Definitions/Resources/CommandIconsSvg/**/*.svg"
                      LogicalName="Writer.Icons.Command.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime and package assets derive from one owned Writer identity source in the shared shell. -->
    <Content Include="$(BrandWindowsIconPath)"
             Link="Resources/$(BrandWindowsIconFileName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(BrandScalableIconPath)"
             Link="Resources/$(BrandScalableIconFileName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(BrandMacOsIconPath)"
             Link="$(BrandMacOsIconFileName)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Writer.Shared.IO" />
    <Using Include="Writer.Shared.AppServices" />
    <Using Include="Writer.App.Presentation.DocumentView" />
  </ItemGroup>

</Project>
