<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Enforce nullable + implicit usings repo-wide so a new project cannot silently opt out.
         Every existing csproj already sets these; centralizing only guards future additions. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Always bundle / roll forward to the latest installed runtime servicing patch. The SDK's
         default self-contained runtime (10.0.8) shipped a broken Linux apphost that throws
         "BadImageFormatException: Bad IL format" on launch; the 10.0.9 patch fixes it. Floating to
         the latest patch keeps self-contained Linux/macOS (Avalonia) and Windows (WPF) publishes on
         a healthy, security-serviced runtime instead of pinning to whatever the SDK defaults to. -->
    <TargetLatestRuntimePatch>true</TargetLatestRuntimePatch>
  </PropertyGroup>

  <!-- Product localization support is explicit. Shared satellites are only packaged and used
       where the product also ships its corresponding app satellite. -->
  <PropertyGroup>
    <WriterSharedLocalizationProjectDirectory Condition="'$(WriterSharedLocalizationProjectDirectory)' == ''">$(MSBuildProjectDirectory)</WriterSharedLocalizationProjectDirectory>
    <WriterSharedLocalizationNormalizedProjectDirectory>$([System.String]::Copy('$(WriterSharedLocalizationProjectDirectory)').Replace('\','/').ToLowerInvariant())</WriterSharedLocalizationNormalizedProjectDirectory>
  </PropertyGroup>
  <!-- Writer is the only product. App projects live at the repository root; the shared layer
       lives under /shared/ and carries no product satellite of its own. -->
  <PropertyGroup Condition="$([System.String]::Copy('$(WriterSharedLocalizationNormalizedProjectDirectory)').Contains('/shared/')) != 'true'">
    <WriterSharedLocalizationProduct>Writer</WriterSharedLocalizationProduct>
    <WriterSharedLocalizationSupportedCultures Condition="'$(WriterSharedLocalizationSupportedCultures)' == ''">fr-FR</WriterSharedLocalizationSupportedCultures>
  </PropertyGroup>
  <PropertyGroup Condition="'$(WriterSharedLocalizationSupportedCultures)' != ''">
    <WriterSharedLocalizationSupportedCulturePattern>$([System.String]::Copy('$(WriterSharedLocalizationSupportedCultures)').Replace(';','|'))</WriterSharedLocalizationSupportedCulturePattern>
    <SatelliteResourceLanguages>$(WriterSharedLocalizationSupportedCultures)</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
