<Project>
  <ItemGroup>
    <!--
      Command icon artwork lives entirely in this folder. The shared FreeX glyphs
      (formerly linked from src/FreeX.Ribbon.Definitions) were vendored here so the
      icon set ships with the repo; the twelve product-specific variants Writer owns
      (arrange-all, breaks, eraser, new-window, paste-special, show-comments,
      show-notes, sort, strikethrough, theme-colors, theme-effects, theme-fonts)
      take precedence and are also stored locally.
    -->
    <Content Include="$(MSBuildThisFileDirectory)Resources/CommandIconsSvg/**/*.svg"
             Link="Resources/CommandIconsSvg/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="$(MSBuildThisFileDirectory)Resources/ContentIconsSvg/**/*.svg"
             Link="Resources/ContentIconsSvg/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest">
      <CopyToPublishDirectory Condition="'$(UseWPF)' != 'true'">PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
