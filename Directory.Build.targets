<Project>
  <Target Name="FilterWriterSharedLocalizationSatelliteResources"
          BeforeTargets="_CopyFilesMarkedCopyLocal;CopyFilesToOutputDirectory"
          Condition="'$(WriterSharedLocalizationProduct)' != ''">
    <ItemGroup>
      <_WriterSharedLocalizationSatellites Include="@(ReferenceCopyLocalPaths)"
        Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Writer.Shared.Localization.resources'" />
      <_WriterSharedLocalizationSupported Include="@(_WriterSharedLocalizationSatellites)"
        Condition="'$(WriterSharedLocalizationFilterAllSatellites)' != 'true' And
          '$([System.Text.RegularExpressions.Regex]::IsMatch(&quot;%(_WriterSharedLocalizationSatellites.DestinationSubDirectory)&quot;, &quot;^($(WriterSharedLocalizationSupportedCulturePattern))[\\/]$&quot;))' == 'True'" />
      <ReferenceCopyLocalPaths Remove="@(_WriterSharedLocalizationSatellites)" />
      <ReferenceCopyLocalPaths Include="@(_WriterSharedLocalizationSupported)" />
    </ItemGroup>
  </Target>

  <Target Name="RemoveWriterSharedLocalizationSatellitesForEnglishOnly"
          AfterTargets="_CopyFilesMarkedCopyLocal"
          Condition="'$(WriterSharedLocalizationFilterAllSatellites)' == 'true'">
    <ItemGroup>
      <_WriterSharedLocalizationEnglishOnlySatellite Include="$(TargetDir)**/Writer.Shared.Localization.resources.dll" />
    </ItemGroup>
    <Delete Files="@(_WriterSharedLocalizationEnglishOnlySatellite)" />
  </Target>
</Project>
